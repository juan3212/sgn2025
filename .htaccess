<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso a archivos sensibles
    <FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Denegar acceso directo a directorios internos
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)(/|$) - [F,L,NC]
</IfModule>
